# Kopieren nach terraform.tfvars und ausfüllen (terraform.tfvars nicht ins Git!)

# Öffentliche IPs der vier Teamgeräte, je als /32 (z. B. über https://checkip.amazonaws.com)
team_ips = [
  "203.0.113.10/32", # Adam
  "203.0.113.11/32", # Edina
  "203.0.113.12/32", # Jovana
  "203.0.113.13/32", # Daria
]

# Inhalt der jeweiligen id_ed25519.pub
ssh_public_keys = [
  "ssh-ed25519 AAAA... adam",
  "ssh-ed25519 AAAA... edina",
  "ssh-ed25519 AAAA... jovana",
  "ssh-ed25519 AAAA... daria",
]

# Erst auf true setzen, wenn BIND auf dns1 und dns2 läuft
use_custom_dhcp = false
